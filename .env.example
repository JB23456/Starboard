# Copy to .env and adjust as needed.
# If no .env is present, the app defaults to file:./production.db
DATABASE_URL="file:./dev.db"

# Optional: Discord notifications for quest status changes.
# Create a webhook: Discord server -> channel -> Settings -> Integrations -> Webhooks -> New Webhook -> copy URL.
# If unset, notifications are silently disabled.
DISCORD_QUEST_WEBHOOK_URL=""

# Public base URL of the app (no trailing slash), used for quest links in Discord messages.
PUBLIC_APP_URL=""
